---
import { siteContent } from '../data/content';
const project = siteContent.telUGig;
---

<section id="telugig" class="py-16 md:py-24 border-b-[3px] border-[#0A0A0A] bg-[#FFE3EE]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header Tag -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 pb-6 border-b-[3px] border-[#0A0A0A]">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#FFE45C] border-2 border-[#0A0A0A] font-mono text-xs font-extrabold uppercase mb-2">
          <span>KARYA UNGGULAN & JUARA 1</span>
        </div>
        <h2 class="font-heading font-extrabold text-3xl sm:text-4xl lg:text-5xl text-[#0A0A0A] tracking-tight">
          TELUGIG — FREELANCE KAMPUS HIPER-LOKAL
        </h2>
      </div>
      <div class="font-mono text-xs sm:text-sm font-bold text-[#8F0F4A] bg-white px-3 py-2 border-2 border-[#0A0A0A] shadow-brutal-sm">
        {project.competition} • {project.date}
      </div>
    </div>

    <!-- Main Grid: Overview & Context -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
      
      <!-- Left Column: Problem & Solution -->
      <div class="lg:col-span-7 flex flex-col gap-6">
        
        <!-- Problem Card -->
        <div class="bg-white border-[3px] border-[#0A0A0A] p-6 shadow-brutal">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-4 h-4 bg-[#FF3D8B] border border-[#0A0A0A] inline-block"></span>
            <h3 class="font-heading font-extrabold text-xl text-[#0A0A0A]">
              01. MASALAH PASAR NYATA
            </h3>
          </div>
          <p class="font-body text-sm sm:text-base text-[#0A0A0A] leading-relaxed">
            {project.problem}
          </p>
        </div>

        <!-- Solution Card -->
        <div class="bg-white border-[3px] border-[#0A0A0A] p-6 shadow-brutal">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-4 h-4 bg-[#FFE45C] border border-[#0A0A0A] inline-block"></span>
            <h3 class="font-heading font-extrabold text-xl text-[#0A0A0A]">
              02. SOLUSI & MODEL BISNIS B2B
            </h3>
          </div>
          <p class="font-body text-sm sm:text-base text-[#0A0A0A] leading-relaxed mb-4">
            {project.solution}
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t-2 border-[#0A0A0A]/10">
            <div class="bg-[#FFE3EE] border-2 border-[#0A0A0A] p-3 text-center">
              <span class="font-mono text-[11px] font-bold text-[#8F0F4A] block">UNTUK MAHASISWA</span>
              <span class="font-heading font-extrabold text-lg text-[#0A0A0A]">100% PENDAPATAN</span>
              <span class="font-mono text-[10px] block mt-0.5">Zero-Fee Policy</span>
            </div>
            <div class="bg-[#FFE3EE] border-2 border-[#0A0A0A] p-3 text-center">
              <span class="font-mono text-[11px] font-bold text-[#8F0F4A] block">REVENUE MODEL</span>
              <span class="font-heading font-extrabold text-lg text-[#0A0A0A]">15% SUCCESS FEE</span>
              <span class="font-mono text-[10px] block mt-0.5">Ditanggung UMKM</span>
            </div>
            <div class="bg-[#FFE3EE] border-2 border-[#0A0A0A] p-3 text-center">
              <span class="font-mono text-[11px] font-bold text-[#8F0F4A] block">KEAMANAN</span>
              <span class="font-heading font-extrabold text-lg text-[#0A0A0A]">ESCROW SYSTEM</span>
              <span class="font-mono text-[10px] block mt-0.5">Mandatory DP</span>
            </div>
          </div>
        </div>

        <!-- Puteri's Role & Contribution (CV Honest Grounding) -->
        <div class="bg-[#FFE45C] border-[3px] border-[#0A0A0A] p-6 shadow-brutal">
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-xs font-extrabold bg-[#0A0A0A] text-[#FFE45C] px-2 py-0.5">
              PERAN PUTERI NAJMA (SESUAI CV)
            </span>
            <span class="font-mono text-xs font-bold text-[#8F0F4A]">Tim: Power Ranger Bojongsoang</span>
          </div>
          <h4 class="font-heading font-extrabold text-lg sm:text-xl text-[#0A0A0A] mb-2">
            {project.puteriRole.cvTitle}
          </h4>
          <p class="font-body text-sm text-[#0A0A0A] leading-relaxed mb-3">
            {project.puteriRole.description}
          </p>
          <div class="p-3 bg-white border-2 border-[#0A0A0A] font-mono text-xs text-[#0A0A0A]">
            <strong class="text-[#8F0F4A]">Catatan Transparansi:</strong> Portofolio ini tidak mengklaim Puteri sebagai founder tunggal. Proyek merupakan kolaborasi tim mahasiswa. Bagian spesifik ditandai: 
            <span class="bg-[#FFE3EE] px-1 font-bold">{project.puteriRole.placeholderNote}</span>.
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Proof (Photos of Team & Certificate) -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        
        <!-- Team Photo on Stage -->
        <div class="bg-white border-[3px] border-[#0A0A0A] shadow-brutal overflow-hidden">
          <div class="bg-[#FF3D8B] text-[#0A0A0A] px-4 py-2 border-b-[3px] border-[#0A0A0A] flex items-center justify-between font-mono text-xs font-extrabold">
            <span>DOKUMENTASI_PANGGUNG_JUARA_1.JPG</span>
            <span class="bg-white text-[#0A0A0A] px-1.5 py-0.2 border border-[#0A0A0A]">BIZCREATE 2026</span>
          </div>
          <div class="aspect-[4/3] bg-black overflow-hidden relative">
            <img
              src={project.teamPhotoUrl}
              alt="Tim Power Ranger Bojongsoang menerima sertifikat Juara 1 BizCREATE 2026 di panggung Telkom University"
              class="w-full h-full object-cover object-center"
              loading="lazy"
            />
          </div>
          <div class="p-4 bg-white font-mono text-xs text-[#0A0A0A] leading-tight border-t-2 border-[#0A0A0A]">
            <strong>Dokumentasi Asli:</strong> Puteri Najma Azzahra dan tim Power Ranger Bojongsoang memegang piagam Juara 1 Business Plan Competition BizCREATE 2026.
          </div>
        </div>

        <!-- Official Certificate of Award -->
        <div class="bg-white border-[3px] border-[#0A0A0A] shadow-brutal overflow-hidden">
          <div class="bg-[#FFE45C] text-[#0A0A0A] px-4 py-2 border-b-[3px] border-[#0A0A0A] flex items-center justify-between font-mono text-xs font-extrabold">
            <span>SERTIFIKAT_JUARA_1_RESMI.JPG</span>
            <span class="font-bold">FKS TELKOM UNIV</span>
          </div>
          <div class="aspect-[4/3] bg-neutral-100 overflow-hidden">
            <img
              src={project.certPhotoUrl}
              alt="Sertifikat Penghargaan Juara 1 Business Plan Competition BizCREATE 2026"
              class="w-full h-full object-contain p-2"
              loading="lazy"
            />
          </div>
          <div class="p-3 bg-white font-mono text-xs text-[#0A0A0A] flex items-center justify-between border-t-2 border-[#0A0A0A]">
            <span>Diterbitkan: 16 Oktober 2026</span>
            <span class="font-bold text-[#8F0F4A]">BEM KEMA FKS</span>
          </div>
        </div>

      </div>

    </div>

    <!-- PURE CSS BRUTALIST MONEY FLOW DIAGRAM -->
    <div class="bg-white border-[3px] border-[#0A0A0A] p-6 sm:p-8 shadow-brutal-lg">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-8 pb-4 border-b-2 border-[#0A0A0A]">
        <div>
          <span class="font-mono text-xs font-extrabold text-[#8F0F4A] tracking-wider uppercase block">
            DIAGRAM ARSITEKTUR BISNIS & ALUR DANA
          </span>
          <h3 class="font-heading font-extrabold text-2xl sm:text-3xl text-[#0A0A0A]">
            Mekanisme Transaksi & Keuangan TelUGig (Escrow + Fee Split)
          </h3>
        </div>
        <span class="font-mono text-xs font-bold bg-[#FFE3EE] border-2 border-[#0A0A0A] px-3 py-1 self-start sm:self-auto shadow-brutal-sm">
          Murni CSS Brutalist
        </span>
      </div>

      <!-- Responsive Balanced Flow Architecture (Flexbox on Desktop) -->
      <div class="flex flex-col lg:flex-row items-stretch gap-3 xl:gap-4">
        
        <!-- STEP 01: UMKM Klien -->
        <div class="flex-1 min-w-0 bg-[#FFE3EE] border-[3px] border-[#0A0A0A] p-5 shadow-brutal-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="font-mono text-[10px] font-extrabold bg-[#0A0A0A] text-white px-2 py-0.5">
                PIHAK 01: KLIEN
              </span>
              <span class="w-2.5 h-2.5 bg-[#FF3D8B] border border-[#0A0A0A]"></span>
            </div>
            <h4 class="font-heading font-extrabold text-xl text-[#0A0A0A] mb-1">
              UMKM Bojongsoang
            </h4>
            <p class="font-mono text-xs font-bold text-[#8F0F4A] mb-3">
              Pemberi Kerja & Pemesan Jasa
            </p>
            <p class="font-body text-xs text-[#0A0A0A] leading-relaxed">
              Membutuhkan digitalisasi operasional (branding visual, katalog produk, media sosial, dan landing page).
            </p>
          </div>

          <div class="mt-4 pt-3 border-t-2 border-[#0A0A0A]/20 bg-white border-2 border-[#0A0A0A] p-3">
            <span class="font-mono text-[10px] font-extrabold text-[#8F0F4A] block uppercase">
              KOMITMEN PEMBAYARAN:
            </span>
            <span class="font-heading font-extrabold text-sm text-[#0A0A0A] block">
              100% Honor + 15% Success Fee
            </span>
            <span class="font-mono text-[11px] text-[#0A0A0A]/80 block mt-0.5">
              Disetor di awal via sistem
            </span>
          </div>
        </div>

        <!-- CONNECTOR 01: Mandatory DP -->
        <div class="flex lg:flex-col items-center justify-center gap-2 py-1 lg:py-0 shrink-0">
          <div class="bg-[#FFE45C] border-[3px] border-[#0A0A0A] px-3.5 py-2.5 shadow-brutal-sm text-center whitespace-nowrap">
            <span class="font-mono text-[9px] font-extrabold text-[#8F0F4A] uppercase block">
              ALUR 01
            </span>
            <span class="font-heading font-extrabold text-xs sm:text-sm text-[#0A0A0A] block leading-tight">
              MANDATORY DP
            </span>
            <span class="font-mono text-[10px] font-bold text-[#0A0A0A] block mt-0.5">
              Uang Muka Wajib
            </span>
          </div>
          <div class="flex items-center justify-center font-heading font-black text-xl text-[#0A0A0A]">
            <span class="lg:hidden">↓</span>
            <span class="hidden lg:inline text-2xl leading-none">➔</span>
          </div>
        </div>

        <!-- STEP 02: Pusat Penjamin / Escrow -->
        <div class="flex-1 min-w-0 bg-[#FFE45C] border-[3px] border-[#0A0A0A] p-5 shadow-brutal flex flex-col justify-between relative">
          <div class="absolute -top-3.5 right-4 bg-[#FF3D8B] text-[#0A0A0A] border-2 border-[#0A0A0A] font-mono text-[10px] font-extrabold px-2 py-0.5 shadow-brutal-sm">
            CORE TELUGIG
          </div>
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="font-mono text-[10px] font-extrabold bg-[#0A0A0A] text-[#FFE45C] px-2 py-0.5">
                PUSAT PENJAMIN
              </span>
            </div>
            <h4 class="font-heading font-extrabold text-xl text-[#0A0A0A] mb-1">
              Rekening Escrow Kampus
            </h4>
            <p class="font-mono text-xs font-bold text-[#8F0F4A] mb-3">
              Sistem Pengaman Transaksi
            </p>
            <p class="font-body text-xs text-[#0A0A0A] leading-relaxed mb-3">
              Mengunci dana <strong>Mandatory DP</strong> sebelum pekerjaan dimulai. Mencegah pembatalan sepihak dan menjamin hak mahasiswa dibayar penuh.
            </p>
            <div class="space-y-1.5 font-mono text-[11px] text-[#0A0A0A] pt-1">
              <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 bg-[#0A0A0A]"></span>
                <span>Anti-Ghosting: Klien terikat komitmen</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 bg-[#0A0A0A]"></span>
                <span>Quality Gate: Verifikasi hasil kerja</span>
              </div>
            </div>
          </div>

          <div class="mt-4 pt-3 border-t-2 border-[#0A0A0A]/20 bg-white border-2 border-[#0A0A0A] p-3">
            <span class="font-mono text-[10px] font-extrabold text-[#0A0A0A] block uppercase">
              STATUS DANA ESCROW:
            </span>
            <span class="font-heading font-extrabold text-sm text-[#8F0F4A] block">
              Terkunci Aman Hingga Approval
            </span>
          </div>
        </div>

        <!-- CONNECTOR 02: Output Verification & Release -->
        <div class="flex lg:flex-col items-center justify-center gap-2 py-1 lg:py-0 shrink-0">
          <div class="bg-[#FFE3EE] border-[3px] border-[#0A0A0A] px-3.5 py-2.5 shadow-brutal-sm text-center whitespace-nowrap">
            <span class="font-mono text-[9px] font-extrabold text-[#8F0F4A] uppercase block">
              ALUR 02
            </span>
            <span class="font-heading font-extrabold text-xs sm:text-sm text-[#0A0A0A] block leading-tight">
              HASIL LOLOS
            </span>
            <span class="font-mono text-[10px] font-bold text-[#0A0A0A] block mt-0.5">
              Pencairan Split
            </span>
          </div>
          <div class="flex items-center justify-center font-heading font-black text-xl text-[#0A0A0A]">
            <span class="lg:hidden">↓</span>
            <span class="hidden lg:inline text-2xl leading-none">➔</span>
          </div>
        </div>

        <!-- STEP 03: Dual Disbursement -->
        <div class="flex-1 min-w-0 flex flex-col gap-3 justify-between">
          
          <!-- Student 100% Zero-Fee -->
          <div class="bg-[#FF3D8B] border-[3px] border-[#0A0A0A] p-4 shadow-brutal-sm text-[#0A0A0A] flex-1">
            <div class="flex items-center justify-between mb-1">
              <span class="font-mono text-[10px] font-extrabold uppercase bg-white px-1.5 py-0.5 border border-[#0A0A0A]">
                MAHASISWA
              </span>
              <span class="font-heading font-extrabold text-sm bg-[#FFE45C] px-1.5 border border-[#0A0A0A]">
                100% UTUH
              </span>
            </div>
            <h5 class="font-heading font-extrabold text-base mt-2">
              Talenta Freelancer Kampus
            </h5>
            <p class="font-body text-xs leading-relaxed mt-1 text-[#0A0A0A]">
              Menerima seluruh honor kerja tanpa potongan komisi (Zero-Fee Policy).
            </p>
          </div>

          <!-- Platform 15% Client Fee -->
          <div class="bg-white border-[3px] border-[#0A0A0A] p-4 shadow-brutal-sm flex-1">
            <div class="flex items-center justify-between mb-1">
              <span class="font-mono text-[10px] font-extrabold uppercase bg-[#FFE45C] px-1.5 py-0.5 border border-[#0A0A0A]">
                PLATFORM
              </span>
              <span class="font-heading font-extrabold text-sm text-[#8F0F4A] bg-[#FFE3EE] px-1.5 border border-[#0A0A0A]">
                15% FEE
              </span>
            </div>
            <h5 class="font-heading font-extrabold text-base mt-2">
              Kas Operasional TelUGig
            </h5>
            <p class="font-body text-xs leading-relaxed mt-1 text-[#0A0A0A]">
              Biaya dibebankan ke UMKM untuk penjaminan kualitas, verifikasi, & server.
            </p>
          </div>

        </div>

      </div>

      <!-- Diagram Summary Note -->
      <div class="mt-8 p-4 bg-[#FFE45C] border-[3px] border-[#0A0A0A] shadow-brutal-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 font-mono text-xs">
        <span class="font-bold text-[#0A0A0A]">
          💡 Dampak Nyata Model TelUGig: Mahasiswa aman berkarya dengan honor 100% terlindungi, UMKM terlindungi dari risiko gagal serah berkat Mandatory DP & Escrow.
        </span>
        <span class="text-[#8F0F4A] font-extrabold whitespace-nowrap bg-white px-2 py-1 border border-[#0A0A0A]">
          Juara 1 BizCREATE 2026
        </span>
      </div>

    </div>

  </div>
</section>
