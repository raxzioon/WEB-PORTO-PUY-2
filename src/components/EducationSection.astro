---
import { siteContent } from '../data/content';
---

<section id="pendidikan" class="py-16 md:py-20 border-b-[3px] border-[#0A0A0A] bg-[#FFE45C]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title Bar -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 pb-6 border-b-[3px] border-[#0A0A0A]">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#0A0A0A] text-[#FFE45C] border-2 border-[#0A0A0A] font-mono text-xs font-extrabold uppercase mb-2">
          <span>LATAR BELAKANG AKADEMIK</span>
        </div>
        <h2 class="font-heading font-extrabold text-3xl sm:text-4xl lg:text-5xl text-[#0A0A0A] tracking-tight">
          RIWAYAT PENDIDIKAN
        </h2>
      </div>
      <p class="font-mono text-xs sm:text-sm text-[#0A0A0A] font-bold max-w-sm">
        Jalur studi formal dari sekolah menengah hingga program sarjana Sistem Informasi di Telkom University.
      </p>
    </div>

    <!-- Education Timeline Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      {siteContent.education.map((edu, index) => (
        <div class="bg-white border-[3px] border-[#0A0A0A] p-6 shadow-brutal flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3 pb-2 border-b-2 border-[#0A0A0A]/10">
              <span class="font-mono text-xs font-extrabold bg-[#FF3D8B] text-[#0A0A0A] px-2 py-0.5 border border-[#0A0A0A]">
                JENJANG 0{3 - index}
              </span>
              <span class="font-mono text-xs font-bold text-[#8F0F4A]">
                {edu.period}
              </span>
            </div>

            <h3 class="font-heading font-extrabold text-2xl text-[#0A0A0A] mb-1">
              {edu.institution}
            </h3>
            <h4 class="font-mono text-sm font-bold text-[#8F0F4A] mb-4">
              {edu.degree}
            </h4>

            <p class="font-body text-xs sm:text-sm text-[#0A0A0A] leading-relaxed mb-4">
              {edu.details}
            </p>
          </div>

          {edu.note && (
            <div class="p-2.5 bg-[#FFE3EE] border-2 border-[#0A0A0A] font-mono text-[11px] text-[#8F0F4A] font-bold leading-tight">
              ⚠️ {edu.note}
            </div>
          )}
        </div>
      ))}

    </div>

  </div>
</section>
