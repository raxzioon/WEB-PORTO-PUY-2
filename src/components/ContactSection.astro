---
import { siteContent } from '../data/content';
const { personal, contact } = siteContent;
---

<section id="kontak" class="py-20 md:py-28 border-b-[3px] border-[#0A0A0A] bg-[#FF3D8B] text-[#0A0A0A] relative overflow-hidden">
  
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Brutalist Callout Container -->
    <div class="bg-white border-[3px] border-[#0A0A0A] p-8 sm:p-12 shadow-brutal-xl">
      
      <!-- Top Tag -->
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#FFE45C] border-2 border-[#0A0A0A] font-mono text-xs font-extrabold uppercase mb-6 shadow-brutal-sm">
        <span>KOLABORASI & KARIER</span>
      </div>

      <!-- Headline -->
      <h2 class="font-heading font-extrabold text-3xl sm:text-5xl lg:text-6xl text-[#0A0A0A] tracking-tight leading-[1.08] mb-6">
        MARI RACIK SESUATU YANG BERDAMPAK BERSAMA.
      </h2>

      <!-- Narrative -->
      <p class="font-body text-base sm:text-lg text-[#0A0A0A] leading-relaxed max-w-2xl mb-8">
        Apakah Anda memiliki proses bisnis yang perlu dipetakan, data operasional yang perlu diubah menjadi dashboard pengambil keputusan, atau panggung acara yang membutuhkan pembicara dengan energi positif? Pintu diskusi terbuka untuk peluang magang, proyek riset, dan peran profesional.
      </p>

      <!-- Action Buttons Grid: WhatsApp, Email, LinkedIn -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
        
        <!-- WhatsApp Direct Button -->
        <a
          href={personal.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-5 py-4 bg-[#FFE45C] text-[#0A0A0A] font-heading font-extrabold text-base brutal-btn text-center"
        >
          <span class="text-xl">💬</span>
          <span>Chat WhatsApp</span>
          <span>↗</span>
        </a>

        <!-- Email Direct Button -->
        <a
          href={`mailto:${personal.email}?subject=Diskusi%20Peluang%20Kolaborasi%20/%20Magang%20-%20Puteri%20Najma`}
          class="inline-flex items-center justify-center gap-2 px-5 py-4 bg-[#FF3D8B] text-[#0A0A0A] font-heading font-extrabold text-base brutal-btn text-center"
        >
          <span class="text-xl">✉️</span>
          <span>Kirim Email</span>
          <span>↗</span>
        </a>

        <!-- LinkedIn Direct Button -->
        <a
          href={personal.linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-5 py-4 bg-white text-[#0A0A0A] font-heading font-extrabold text-base brutal-btn text-center"
        >
          <span class="text-xl">🔗</span>
          <span>Profil LinkedIn</span>
          <span>↗</span>
        </a>

      </div>

      <!-- Footer Meta of Contact Box -->
      <div class="pt-6 border-t-2 border-[#0A0A0A] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 font-mono text-xs text-[#0A0A0A]">
        <div>
          <span class="font-bold">Email Formal:</span> <code class="bg-[#FFE3EE] px-1.5 py-0.5 border border-[#0A0A0A]">{personal.email}</code>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 bg-green-500 rounded-full border border-[#0A0A0A]"></span>
          <span class="font-bold">Status: Terbuka untuk Magang / Proyek</span>
        </div>
      </div>

    </div>

  </div>
</section>
