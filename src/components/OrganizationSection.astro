---
import { siteContent } from '../data/content';
---

<section id="organisasi" class="py-16 md:py-24 border-b-[3px] border-[#0A0A0A] bg-[#FFE3EE]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title Bar -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12 pb-6 border-b-[3px] border-[#0A0A0A]">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#FF3D8B] text-[#0A0A0A] border-2 border-[#0A0A0A] font-mono text-xs font-extrabold uppercase mb-2">
          <span>JEJAK KEPEMIMPINAN & OPERASIONAL</span>
        </div>
        <h2 class="font-heading font-extrabold text-3xl sm:text-4xl lg:text-5xl text-[#0A0A0A] tracking-tight">
          PENGALAMAN & ORGANISASI
        </h2>
      </div>
      <p class="font-mono text-xs sm:text-sm text-[#8F0F4A] font-bold max-w-md">
        Rekam jejak kepemimpinan nyata: dari pengelolaan SDM developer, manajemen krisis kedisiplinan, hingga tata kelola berkas perizinan.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {siteContent.organizations.map((org, index) => (
        <div class="bg-white border-[3px] border-[#0A0A0A] p-6 sm:p-7 shadow-brutal flex flex-col justify-between relative group hover:translate-x-1 hover:translate-y-1 hover:shadow-brutal-sm transition-all duration-150">
          
          <div>
            <!-- Card Top Bar -->
            <div class="flex items-center justify-between gap-2 mb-4 pb-3 border-b-2 border-[#0A0A0A]/10">
              <span class="px-2.5 py-1 bg-[#FFE45C] text-[#0A0A0A] font-mono text-xs font-extrabold border border-[#0A0A0A]">
                {org.badge}
              </span>
              <span class="font-mono text-xs font-bold text-[#8F0F4A]">
                {org.period}
              </span>
            </div>

            <!-- Role & Organization -->
            <h3 class="font-heading font-extrabold text-2xl text-[#0A0A0A] mb-1 leading-snug">
              {org.role}
            </h3>
            <h4 class="font-mono text-sm font-bold text-[#8F0F4A] mb-4">
              {org.organization}
            </h4>

            <!-- Core Impact (Hasil di depan, 1 kalimat tegas) -->
            <div class="p-3.5 bg-[#FFE3EE] border-2 border-[#0A0A0A] mb-5">
              <span class="font-mono text-[10px] font-extrabold text-[#8F0F4A] uppercase block mb-1">
                FOKUS HASIL & KONTRIBUSI:
              </span>
              <p class="font-body text-sm font-semibold text-[#0A0A0A] leading-relaxed">
                "{org.impactLine}"
              </p>
            </div>

            <!-- Detail Bullet Points -->
            <ul class="space-y-2 mb-4">
              {org.details.map((detail) => (
                <li class="flex items-start gap-2.5 font-body text-xs sm:text-sm text-[#0A0A0A] leading-relaxed">
                  <span class="w-2 h-2 bg-[#FF3D8B] border border-[#0A0A0A] mt-1.5 flex-shrink-0"></span>
                  <span>{detail}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Bottom Card Meta -->
          <div class="pt-4 border-t-2 border-[#0A0A0A]/10 flex items-center justify-between font-mono text-xs">
            <span class="font-bold text-[#0A0A0A]">Keahlian Terpakai:</span>
            <span class="text-[#8F0F4A] font-extrabold">Kepemimpinan • Koordinasi • Asertivitas</span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
