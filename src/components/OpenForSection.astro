---
import { siteContent } from '../data/content';
---

<section id="terbuka" class="py-16 md:py-24 border-b-[3px] border-[#0A0A0A] bg-[#FFE3EE]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title Bar -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12 pb-6 border-b-[3px] border-[#0A0A0A]">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#FF3D8B] text-[#0A0A0A] border-2 border-[#0A0A0A] font-mono text-xs font-extrabold uppercase mb-2">
          <span>PENGGANTI RATE CARD TEMPLATE LAMA</span>
        </div>
        <h2 class="font-heading font-extrabold text-3xl sm:text-4xl lg:text-5xl text-[#0A0A0A] tracking-tight">
          TERBUKA UNTUK PELUANG KERJA & KOLABORASI
        </h2>
      </div>
      <p class="font-mono text-xs sm:text-sm text-[#8F0F4A] font-bold max-w-md bg-white p-3 border-2 border-[#0A0A0A] shadow-brutal-sm">
        Seksi ini menggantikan tab "Rate Card" dari template lama menjadi penawaran peran profesional yang relevan bagi perekrut dan penyelenggara kegiatan.
      </p>
    </div>

    <!-- Opportunity Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      {siteContent.openFor.map((item, index) => (
        <div class="bg-white border-[3px] border-[#0A0A0A] p-6 shadow-brutal flex flex-col justify-between hover:translate-x-1 hover:translate-y-1 hover:shadow-brutal-sm transition-all duration-150">
          
          <div>
            <div class="flex items-center justify-between mb-3 pb-2 border-b-2 border-[#0A0A0A]/10">
              <span class="px-2.5 py-0.5 bg-[#FFE45C] text-[#0A0A0A] font-mono text-[11px] font-extrabold border border-[#0A0A0A]">
                {item.category}
              </span>
              <span class="font-mono text-xs font-bold text-[#8F0F4A]">
                PELUANG 0{index + 1}
              </span>
            </div>

            <h3 class="font-heading font-extrabold text-xl text-[#0A0A0A] mb-3 leading-snug">
              {item.title}
            </h3>

            <p class="font-body text-xs sm:text-sm text-[#0A0A0A] leading-relaxed mb-5">
              {item.description}
            </p>

            <!-- Expected Deliverables -->
            <div class="mb-4">
              <span class="font-mono text-[11px] font-extrabold text-[#8F0F4A] uppercase block mb-2">
                LUARAN / KONTRIBUSI UTAMA:
              </span>
              <ul class="space-y-1.5">
                {item.deliverables.map((d) => (
                  <li class="flex items-center gap-2 font-mono text-xs text-[#0A0A0A]">
                    <span class="w-1.5 h-1.5 bg-[#FF3D8B] border border-[#0A0A0A]"></span>
                    <span>{d}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="pt-4 border-t-2 border-[#0A0A0A]/10">
            <a
              href="#kontak"
              class="w-full inline-flex items-center justify-center gap-1.5 py-2 px-3 bg-[#FFE3EE] hover:bg-[#FF3D8B] text-[#0A0A0A] font-mono text-xs font-bold border-2 border-[#0A0A0A] shadow-brutal-sm transition-colors text-center"
            >
              <span>Diskusikan Posisi Ini</span>
              <span>→</span>
            </a>
          </div>

        </div>
      ))}

    </div>

  </div>
</section>
