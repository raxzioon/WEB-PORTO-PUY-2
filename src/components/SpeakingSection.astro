---
import { siteContent } from '../data/content';
---

<section id="panggung" class="py-16 md:py-24 border-b-[3px] border-[#0A0A0A] bg-[#FFE45C]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title Bar -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12 pb-6 border-b-[3px] border-[#0A0A0A]">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#0A0A0A] text-[#FFE45C] border-2 border-[#0A0A0A] font-mono text-xs font-extrabold uppercase mb-2">
          <span>PEMBEDA UTAMA: ANALIS YANG BISA PEGANG MIC</span>
        </div>
        <h2 class="font-heading font-extrabold text-3xl sm:text-4xl lg:text-5xl text-[#0A0A0A] tracking-tight">
          KOMUNIKASI PUBLIK & PANGGUNG
        </h2>
      </div>
      <p class="font-mono text-xs sm:text-sm text-[#0A0A0A] font-bold max-w-md bg-white p-3 border-2 border-[#0A0A0A] shadow-brutal-sm">
        Banyak analis data mahir di balik spreadsheet, namun grogi di panggung. Puteri terbiasa memandu ratusan audiens dan menguji ketahanan vokal di panggung nasional.
      </p>
    </div>

    <!-- 2 Column Speaking & Performance Showcase -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
      
      <!-- Card 1: MC & Pembicara Sosialisasi SMP Jakarta Selatan -->
      <div class="bg-white border-[3px] border-[#0A0A0A] p-6 sm:p-8 shadow-brutal flex flex-col justify-between h-full">
        <div>
          <div class="flex flex-wrap items-center justify-between gap-2 mb-4 pb-3 border-b-2 border-[#0A0A0A]/10">
            <span class="px-2.5 py-1 bg-[#FF3D8B] text-[#0A0A0A] font-mono text-xs font-extrabold border border-[#0A0A0A]">
              MC & SOSIALISASI EDUKASI
            </span>
            <span class="font-mono text-xs font-bold text-[#8F0F4A]">
              Wilayah Jakarta Selatan
            </span>
          </div>

          <h3 class="font-heading font-extrabold text-2xl text-[#0A0A0A] mb-2 leading-tight">
            Pembawa Acara (MC) & Pembicara Sosialisasi SMP
          </h3>
          <p class="font-body text-sm text-[#0A0A0A] leading-relaxed mb-6">
            Memandu jalannya rangkaian sosialisasi tatap muka ke berbagai Sekolah Menengah Pertama (SMP) di Jakarta Selatan. Bertanggung jawab membuka acara, mencairkan suasana di hadapan ratusan siswa remaja, dan menyampaikan materi pengenalan jenjang pendidikan dengan bahasa interaktif, lugas, dan menyenangkan.
          </p>

          <!-- Authentic Documentation Photo on Stage -->
          <div class="border-[3px] border-[#0A0A0A] bg-neutral-100 overflow-hidden mb-6 shadow-brutal-sm">
            <div class="bg-[#FFE45C] px-3 py-1.5 border-b-2 border-[#0A0A0A] flex items-center justify-between font-mono text-[11px] font-extrabold text-[#0A0A0A]">
              <span class="truncate pr-2">DOKUMENTASI_PANGGUNG_SOSIALISASI.PNG</span>
              <span class="flex-shrink-0 bg-white px-1 border border-[#0A0A0A]">SMP DI JAKARTA SELATAN</span>
            </div>
            <div class="aspect-[16/10] overflow-hidden flex items-center justify-center bg-black">
              <img
                src="/images/dokumentasi-sosialisasi-mc.png"
                alt="Dokumentasi Puteri Najma Azzahra saat memandu presentasi sosialisasi di panggung aula sekolah"
                class="w-full h-full object-cover object-center filter contrast-[1.02]"
                loading="lazy"
              />
            </div>
            <div class="p-2.5 bg-white border-t border-[#0A0A0A] font-mono text-[11px] text-[#0A0A0A] flex flex-wrap items-center justify-between gap-1">
              <span>Materi: Pengenalan & Sosiologi Pendidikan</span>
              <span class="font-bold text-[#8F0F4A]">Dokumentasi Panggung</span>
            </div>
          </div>

          <!-- Public Speaking Highlights -->
          <div class="grid grid-cols-2 gap-3 pt-2">
            <div class="p-3 bg-[#FFE45C] border-2 border-[#0A0A0A]">
              <span class="font-mono text-[10px] font-bold text-[#8F0F4A] block">PENDEKATAN</span>
              <span class="font-heading font-extrabold text-sm text-[#0A0A0A]">Komunikasi Dua Arah</span>
            </div>
            <div class="p-3 bg-[#FFE45C] border-2 border-[#0A0A0A]">
              <span class="font-mono text-[10px] font-bold text-[#8F0F4A] block">KONTROL AUDIENS</span>
              <span class="font-heading font-extrabold text-sm text-[#0A0A0A]">Penguasaan Panggung</span>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t-2 border-[#0A0A0A]/10 font-mono text-xs text-[#0A0A0A] flex flex-wrap items-center justify-between gap-1">
          <span class="font-bold">Kemampuan Inti:</span>
          <span class="text-[#8F0F4A] font-extrabold">Public Speaking • Interaksi Audiens • Storytelling</span>
        </div>
      </div>

      <!-- Card 2: Silver Diploma Paduan Suara Tingkat Nasional (Arkasvara 14) -->
      <div class="bg-white border-[3px] border-[#0A0A0A] p-6 sm:p-8 shadow-brutal flex flex-col justify-between h-full">
        <div>
          <div class="flex flex-wrap items-center justify-between gap-2 mb-4 pb-3 border-b-2 border-[#0A0A0A]/10">
            <span class="px-2.5 py-1 bg-[#FFE45C] text-[#0A0A0A] font-mono text-xs font-extrabold border border-[#0A0A0A]">
              PRESTASI SENI TINGKAT NASIONAL
            </span>
            <span class="font-mono text-xs font-bold text-[#8F0F4A]">
              11 Mei 2024
            </span>
          </div>

          <h3 class="font-heading font-extrabold text-2xl text-[#0A0A0A] mb-2 leading-tight">
            Silver Diploma — The 3rd Jakarta National Choir Competition
          </h3>
          <p class="font-body text-sm text-[#0A0A0A] leading-relaxed mb-4">
            Berpartisipasi aktif sebagai anggota tim paduan suara <strong>Arkasvara 14 (SMAN 14 Jakarta)</strong> dalam kompetisi paduan suara tingkat nasional. Membuktikan kedisiplinan jadwal latihan intensif, kepekaan harmonisasi vokal kelompok, dan ketenangan mental menghadapi dewan juri bertaraf internasional.
          </p>

          <!-- Authentic Certificate Visual -->
          <div class="border-[3px] border-[#0A0A0A] bg-neutral-100 overflow-hidden mb-6 shadow-brutal-sm">
            <div class="bg-[#FF3D8B] px-3 py-1.5 border-b-2 border-[#0A0A0A] flex items-center justify-between font-mono text-[11px] font-extrabold text-[#0A0A0A]">
              <span class="truncate pr-2">SERTIFIKAT_SILVER_DIPLOMA.JPG</span>
              <span class="flex-shrink-0 bg-white px-1 border border-[#0A0A0A]">SKOR: 72.93</span>
            </div>
            <div class="aspect-[16/10] overflow-hidden flex items-center justify-center bg-white p-2">
              <img
                src="/images/cert-arkasvara-choir.jpg"
                alt="Sertifikat Silver Diploma The 3rd Jakarta National Choir Competition Arkasvara 14 SMAN 14 Jakarta"
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>
            <div class="p-2.5 bg-white border-t border-[#0A0A0A] font-mono text-[11px] text-[#0A0A0A] flex flex-wrap items-center justify-between gap-1">
              <span>Diakui oleh: 3 Adjudicator Nasional</span>
              <span class="font-bold text-[#8F0F4A]">May 11th, 2024</span>
            </div>
          </div>

          <!-- Key Learnings -->
          <div class="grid grid-cols-2 gap-3 pt-2">
            <div class="p-3 bg-[#FFE3EE] border-2 border-[#0A0A0A]">
              <span class="font-mono text-[10px] font-bold text-[#8F0F4A] block">KEDISIPLINAN</span>
              <span class="font-heading font-extrabold text-sm text-[#0A0A0A]">Latihan Konsisten</span>
            </div>
            <div class="p-3 bg-[#FFE3EE] border-2 border-[#0A0A0A]">
              <span class="font-mono text-[10px] font-bold text-[#8F0F4A] block">HARMONISASI</span>
              <span class="font-heading font-extrabold text-sm text-[#0A0A0A]">Sinkronisasi Tim</span>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t-2 border-[#0A0A0A]/10 font-mono text-xs text-[#0A0A0A] flex items-center justify-between">
          <span class="font-bold">Keahlian Terpakai:</span>
          <span class="text-[#8F0F4A] font-extrabold">Fokus Tinggi • Kerja Sama Padat • Keberanian Panggung</span>
        </div>
      </div>

    </div>

  </div>
</section>
